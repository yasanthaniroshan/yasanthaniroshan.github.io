---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PublicationItem from '../components/PublicationItem.astro';
import profile from '../assets/profile.webp';
import { publications } from '../data/publications';
import { news } from '../data/news';

const featuredPublications = publications.filter((p) => p.featured);

const visibleNewsCount = 3;
const visibleNews = news.slice(0, visibleNewsCount);
const olderNews = news.slice(visibleNewsCount);
---

<Base title="Yasantha Niroshan">
	<div class="intro">
		<Image
			src={profile}
			alt="Yasantha Niroshan"
			width={115}
			height={115}
			densities={[1, 2]}
			loading="eager"
			fetchpriority="high"
		/>
		<div>
			<h1>Yasantha Niroshan</h1>
			<p class="tagline">Graduate Research Assistant · University of Moratuwa</p>
			<ul class="quick-links">
				<li><a href="mailto:yasantha.21@cse.mrt.ac.lk"><Icon name="mail" /> Email</a></li>
				<li><a href="https://scholar.google.com/citations?user=GZNFVeEAAAAJ&hl=en" rel="noopener"><Icon name="scholar" /> Scholar</a></li>
				<li><a href="https://orcid.org/0009-0009-8004-4831" rel="noopener"><Icon name="orcid" /> ORCID</a></li>
				<li><a href="https://github.com/yasanthaniroshan" rel="noopener"><Icon name="github" /> GitHub</a></li>
				<li><a href="https://linkedin.com/in/yasantha-niroshan" rel="noopener"><Icon name="linkedin" /> LinkedIn</a></li>
			</ul>
		</div>
	</div>

	<p class="lede">
		I work on <strong>machine learning under tight resource budgets</strong>. 
	</p>
	<p>
		I hold a B.Sc. (Hons) in Computer Science and Engineering from the <a
			href="https://uom.lk"
			rel="noopener">University of Moratuwa</a
		>, where I'm now a Graduate Research Assistant working on predictive monitoring. I was
		previously Lead Software Engineer at <a href="https://roboticgen.co" rel="noopener"
			>RoboticGen</a
		>.
	</p>

	<h2>News</h2>
	<ul class="news-list">
		{
			visibleNews.map((item) => (
				<li>
					<span class="news-date">{item.date}</span>
					<span>{item.text}</span>
				</li>
			))
		}
	</ul>
	{
		olderNews.length > 0 && (
			<details class="news-more">
				<summary>Show {olderNews.length} more</summary>
				<ul class="news-list">
					{olderNews.map((item) => (
						<li>
							<span class="news-date">{item.date}</span>
							<span>{item.text}</span>
						</li>
					))}
				</ul>
			</details>
		)
	}

	<h2>Research Interests</h2>
	<ul class="tags interests">
		<li>Embedded Machine Learning (TinyML)</li>
		<li>Neuromorphic Computing</li>
		<li>Resource-Constrained Neural Network Optimization</li>
		<li>Efficient Edge Inference</li>
	</ul>

	<h2>Selected Publications</h2>
	{featuredPublications.map((publication) => <PublicationItem publication={publication} />)}
	<p class="back-link"><a href="/publications">All publications →</a> · <a href="/cv">Full CV →</a></p>
</Base>
