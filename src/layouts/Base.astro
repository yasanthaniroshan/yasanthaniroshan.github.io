---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = 'Yasantha Niroshan — Computer Science & Engineering graduate from the University of Moratuwa, working on embedded machine learning.',
} = Astro.props;

const nav = [
	{ href: '/', label: 'Home' },
	{ href: '/projects', label: 'Projects' },
	{ href: '/publications', label: 'Publications' },
	{ href: '/cv', label: 'CV' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Yasantha Niroshan',
	url: 'https://yasantha.me',
	image: new URL('/profile.webp', Astro.site).toString(),
	jobTitle: 'Graduate Research Assistant',
	affiliation: {
		'@type': 'CollegeOrUniversity',
		name: 'University of Moratuwa',
	},
	email: 'mailto:yasantha.21@cse.mrt.ac.lk',
	sameAs: [
		'https://scholar.google.com/citations?user=GZNFVeEAAAAJ&hl=en',
		'https://orcid.org/0009-0009-8004-4831',
		'https://github.com/yasanthaniroshan',
		'https://linkedin.com/in/yasantha-niroshan',
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Yasantha Niroshan" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
		<meta property="og:image" content={new URL('/profile.webp', Astro.site)} />
		<meta name="twitter:card" content="summary" />
		<meta name="theme-color" content="#fdfcf9" />
		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-DCXP45GZ9F"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag('js', new Date());
			gtag('config', 'G-DCXP45GZ9F');
			// re-send page_view on client-side navigation, since ClientRouter
			// swaps content without a full reload that gtag.js would otherwise catch
			document.addEventListener('astro:after-swap', () => {
				gtag('event', 'page_view', {
					page_location: location.href,
					page_path: location.pathname,
					page_title: document.title,
				});
			});
		</script>
		<ClientRouter />
		<script is:inline>
			// restore saved theme before first paint, and again after every
			// client-side navigation (ClientRouter resets <html> attributes
			// to match the freshly fetched page, which has no data-theme)
			function currentIsDark() {
				const theme = document.documentElement.dataset.theme;
				return theme ? theme === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
			}
			function syncThemeUI() {
				const isDark = currentIsDark();
				const btn = document.querySelector('.theme-toggle');
				if (btn) btn.setAttribute('aria-pressed', String(isDark));
				const meta = document.querySelector('meta[name="theme-color"]');
				if (meta) meta.setAttribute('content', isDark ? '#121316' : '#fdfcf9');
			}
			function restoreTheme() {
				const saved = localStorage.getItem('theme');
				if (saved === 'light' || saved === 'dark') {
					document.documentElement.dataset.theme = saved;
				}
				syncThemeUI();
			}
			restoreTheme();
			document.addEventListener('astro:after-swap', restoreTheme);
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<div class="wrapper">
			<header class="site-header">
				<a class="site-title" href="/">Yasantha Niroshan</a>
				<nav class="site-nav">
					{
						nav.map((item) => (
							<a
								href={item.href}
								aria-current={currentPath === item.href ? 'page' : undefined}
							>
								{item.label}
							</a>
						))
					}
					<a href="https://blog.yasantha.me" rel="noopener">Blog&thinsp;↗</a>
					<button
						class="theme-toggle"
						aria-label="Toggle color theme"
						aria-pressed="false"
						transition:persist
					>
						<span class="moon">☾</span><span class="sun">☀</span>
					</button>
				</nav>
			</header>
			<main id="main-content">
				<slot />
			</main>
			<footer class="site-footer" transition:persist>
				<a href="mailto:yasantha.21@cse.mrt.ac.lk">yasantha.21@cse.mrt.ac.lk</a>
				<a href="https://github.com/yasanthaniroshan" rel="noopener">github.com/yasanthaniroshan</a>
			</footer>
		</div>
		<script is:inline>
			document.querySelector('.theme-toggle').addEventListener('click', () => {
				const root = document.documentElement;
				const isDark = currentIsDark();
				root.dataset.theme = isDark ? 'light' : 'dark';
				localStorage.setItem('theme', root.dataset.theme);
				syncThemeUI();
			});
		</script>
	</body>
</html>
